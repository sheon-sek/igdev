# Runtime targets
IGNITION_VERSION=8.3.8
JYTHON_VERSION=2.7.4

# Local-only Gateway binding. Keep 127.0.0.1 unless you intentionally want LAN access.
GATEWAY_BIND_ADDRESS=127.0.0.1
GATEWAY_HTTP_PORT=auto
GATEWAY_HTTPS_PORT=auto
GATEWAY_DEBUG_PORT=auto
GATEWAY_NAME=auto
GATEWAY_MAX_MEMORY_MB=2048
GATEWAY_ADMIN_USERNAME=admin
GATEWAY_ADMIN_PASSWORD=change-me-dev-only
IGNITION_EDITION=standard
TZ=Asia/Kuala_Lumpur

# Must be explicitly changed to Y, or use: ./devctl bootstrap --accept-eula
ACCEPT_IGNITION_EULA=N

# Modules enabled for the default engineering/MCP test profile.
# This is intentionally only a subset of the Ignition 8.3 built-in catalog.
# Run './devctl module catalog' for every supported built-in identifier.
# Run './devctl module list [--built-in|--private]' for the effective environment.
# Remove anything you do not need, or leave blank to avoid whitelisting modules.
GATEWAY_MODULES_ENABLED=com.inductiveautomation.perspective,com.inductiveautomation.historian,com.inductiveautomation.opcua,com.inductiveautomation.webdev,com.inductiveautomation.mcp
ACCEPT_MODULE_CERTS=com.inductiveautomation.mcp
ACCEPT_MODULE_LICENSES=
IGNITION_ALLOW_UNSIGNED_MODULES=false

# Optional global cache for licensed/private .modl files. The folder is version-scoped.
MODULE_CACHE_ROOT=${HOME}/.cache/ignition-devenv/modules

# Optional deterministic baseline Gateway backup. Absolute path recommended.
# GATEWAY_BACKUP=/absolute/path/to/dev-baseline.gwbk
GATEWAY_BACKUP=

# Optional project adapter commands. Leave blank in this foundation repo.
# When vendored into an application repo, these let all agents/CI use one command contract.
PROJECT_CHECK_CMD=
PROJECT_TEST_CMD=
PROJECT_BUILD_CMD=
PROJECT_MODULE_GLOB=
JYTHON_SOURCE_PATHS=

# Optional colon-separated source paths for module capability preflight scanning.
# ./devctl check scans these plus JYTHON_SOURCE_PATHS before project tests.
MODULE_REQUIREMENT_PATHS=

# Optional REST catalog override. Leave blank to auto-select
# config/rest-endpoints-${IGNITION_VERSION}.tsv.
REST_ENDPOINT_CATALOG=

# Set to 1 if ./devctl verify should start a real Gateway and run the smoke check.
VERIFY_GATEWAY=0

# act behavior. First run should normally stay online so images/actions can be fetched.
ACT_OFFLINE=0
