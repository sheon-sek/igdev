# igdev Compose environment for Instance {{ .Namespace }} (generated; do not edit).
#
# Passed to docker compose with `--env-file`, so the Compose file never has to be
# assembled by hand. The Gateway admin credentials are deliberately absent:
# `.igdev/local.toml` (mode 0600) holds them, and the igdev process supplies them
# from its environment at `gateway up` time. Nothing here is a secret, which is
# what keeps this file renderable, diffable, and byte-identical across setups.
IGNITION_VERSION={{ .IgnitionVersion }}
JYTHON_VERSION={{ .JythonVersion }}
COMPOSE_PROJECT_NAME={{ .Namespace }}
GATEWAY_NAME={{ .Namespace }}
GATEWAY_BIND_ADDRESS={{ .BindAddress }}
GATEWAY_HTTP_PORT={{ .Ports.HTTP }}
GATEWAY_HTTPS_PORT={{ .Ports.HTTPS }}
GATEWAY_DEBUG_PORT={{ .Ports.Debug }}
GATEWAY_MAX_MEMORY_MB={{ .MemoryMB }}
IGNITION_EDITION={{ .Edition }}
IGNITION_ALLOW_UNSIGNED_MODULES={{ .AllowUnsignedModules }}
GATEWAY_MODULES_ENABLED={{ .ModuleList }}
TZ={{ .Timezone }}
IGDEV_INSTANCE_ID={{ .InstanceID }}
IGDEV_MODULES_PATH={{ .ModulesDir }}
IGDEV_BASELINE_PATH={{ .BaselineDir }}
